	// Restore original STINT_DIV_BY_ZERO handler
	push8 $STINT_DIV_BY_ZERO
	call :restore_int_handler
	pop8

	//
	// Test that null pointer dereferences generate STINT_BAD_IO_ACCESS
	//
	push64 0
	// For load8
	push8 $STINT_BAD_IO_ACCESS
	call :set_int_handler
	pop8
	load8  // Generates STINT_BAD_IO_ACCESS before push
	push8 [:handled_data]
	push8 $STINT_BAD_IO_ACCESS
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For load16
	push8 0
	pop8 [:handled_data]
	load16 // Generates STINT_BAD_IO_ACCESS before push
	push8 [:handled_data]
	push8 $STINT_BAD_IO_ACCESS
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For load32
	push8 0
	pop8 [:handled_data]
	load32 // Generates STINT_BAD_IO_ACCESS before push
	push8 [:handled_data]
	push8 $STINT_BAD_IO_ACCESS
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For load64
	push8 0
	pop8 [:handled_data]
	load64 // Generates STINT_BAD_IO_ACCESS before push
	push8 [:handled_data]
	push8 $STINT_BAD_IO_ACCESS
	ceq8
	pop8 [$IO_ASSERT_ADDR]

	// For loadpop8
	push8 0
	pop8 [:handled_data]
	loadpop8  // Generates STINT_BAD_IO_ACCESS before pop
	push8 [:handled_data]
	push8 $STINT_BAD_IO_ACCESS
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For loadpop16
