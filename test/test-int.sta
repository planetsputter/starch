	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For modru16
	push8 0
	pop8 [:handled_data]
	push16 0                // 0_16
	push16 [$IO_URAND_ADDR] // 0_16, a16
	modru16                 // Generates STINT_DIV_BY_ZERO before pop takes place
	pop16
	pop16
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For modru32
	push8 0
	pop8 [:handled_data]
	push32 0                // 0_32
	push32 [$IO_URAND_ADDR] // 0_32, a32
	modru32                 // Generates STINT_DIV_BY_ZERO before pop takes place
	pop32
	pop32
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For modru64
	push8 0
	pop8 [:handled_data]
	push64 0                // 0_64
	push64 [$IO_URAND_ADDR] // 0_64, a64
	modru64                 // Generates STINT_DIV_BY_ZERO before pop takes place
