	ceq8
	pop8 [$IO_ASSERT_ADDR]

	pop64 // Pop the NULL address

	// Restore the STINT_BAD_IO_ACCESS handler
	push8 $STINT_BAD_IO_ACCESS
	call :restore_int_handler
	pop8

	ret
