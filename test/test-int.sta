	// For modru8
	push8 0
	pop8 [:handled_data]
	push8 0                // 0_8
	push8 [$IO_URAND_ADDR] // 0_8, a8
	modru8                 // Generates STINT_DIV_BY_ZERO before pop takes place
	pop8
