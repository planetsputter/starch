// test-int.sta
//
// Test interrupts

// Memory map
// 0x0000 - 0x1000: reserved
// 0x1000 - 0x2000: IO
// 0x2000 - 0x3000: interrupt
// 0x3000 - 0x4000: program
// 0x4000 - 0x5000: stack
// 0x5000 - 0x6000: static

//
// Definitions
//
define SUP_STACK_BOTTOM 0x4000
define SUP_STACK_LIMIT  0x5000
define USR_STACK_BOTTOM 0x5000
define USR_STACK_LIMIT  0x6000
define STATIC_ADDR  0x6000
define MAX_REPS     64

//
// Static data section
//
section $STATIC_ADDR

:rep64_data data64 0
:handled_data data8 0 // Index of last handled interrupt

//
// Instruction section
//
section $INIT_PC_VAL

// Set up supervisor stack
setsbp $SUP_STACK_BOTTOM
setsfp $SUP_STACK_BOTTOM
setsp  $SUP_STACK_BOTTOM
setslp $SUP_STACK_LIMIT

// Set up user stack
incctx
setsbp $USR_STACK_BOTTOM
setsfp $USR_STACK_BOTTOM
setsp  $USR_STACK_BOTTOM
setslp $USR_STACK_LIMIT

//
// Main program loop
//
:begin
	push64 [:rep64_data] // rep64
	dup64                // rep64, rep64
	push64 $MAX_REPS     // rep64, rep64, $MAX_REPS
	cltu64               // rep64, rep64 < $MAX_REPS
	brz64 :end           // rep64
	call :test_int
	push64 1             // rep64, 1_64
	add64                // rep64 + 1_64
	pop64 [:rep64_data]  // rep64 = rep64 + 1
	rjmp :begin
:end
	halt 0

//
// Generic interrupt handler which simply records which interrupt was handled
//
:handle_int
	push8 [SFP-2]
	store8 [:handled_data] // Record which interrupt was handled
	reti

//
// Set the given interrupt handler to :handle_int
//
:set_int_handler  // void set_int_handler(intu8)
	push8 [SFP-1] // intu8
	prom8u64      // intu64
	push64 16
	mul64         // intu64 * 16
	push64 $BEGIN_INT_ADDR
	add64         // intu64 * 16 + $BEGIN_INT_ADDR
	push8 $OP_JMP // intu64 * 16 + $BEGIN_INT_ADDR, $OP_JMP
	storepop8     // [intu64 * 16 + $BEGIN_INT_ADDR] = $OP_JMP
	push64 1      // intu64 * 16 + $BEGIN_INT_ADDR, 1
	add64         // intu64 * 16 + $BEGIN_INT_ADDR + 1
	push64 :handle_int // intu64 * 16 + $BEGIN_INT_ADDR + 1, :handle_int
	store64       // [intu64 * 16 + $BEGIN_INT_ADDR + 1] = :handle_int
	ret

//
// Restores the handler for the given interrupt to one that simply halts with the interrupt code
//
:restore_int_handler // void restore_int_handler(intu8)
	push8 [SFP-1]    // intu8
	prom8u64         // intu64
	push64 16
	mul64            // intu64 * 16
	push64 $BEGIN_INT_ADDR
	add64            // intu64 * 16 + $BEGIN_INT_ADDR
	push8 $OP_HALT   // intu64 * 16 + $BEGIN_INT_ADDR, $OP_HALT
	storepop8        // [intu64 * 16 + $BEGIN_INT_ADDR] = $OP_HALT
	push64 1         // intu64 * 16 + $BEGIN_INT_ADDR, 1
	add64            // intu64 * 16 + $BEGIN_INT_ADDR + 1
	push8 [SFP-1]    // intu64 * 16 + $BEGIN_INT_ADDR + 1, intu8
	store8           // [intu64 * 16 + $BEGIN_INT_ADDR + 1] = intu8
	ret
	

//
// Test interrupts
//
:test_int
	//
	// Test that invalid instructions generate STINT_INVALID_INST
	//
	// Call set_int_handler($STINT_INVALID_INST)
	push8 $STINT_INVALID_INST
	call :set_int_handler
	pop8
	invalid // Trigger invalid instruction interrupt
	// Check that :handled_data is equal to $STINT_INVALID_INST
	push8 [:handled_data]
	push8 $STINT_INVALID_INST
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// We want to show that 0x00 is an invalid instruction, because it is common in data
	push8 0
	pop8 [:handled_data]
	data8 0 // Trigger invalid instruction interrupt
	push8 [:handled_data]
	push8 $STINT_INVALID_INST
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// We want to show that 0xff is an invalid instruction, because it is common in data
	push8 0
	pop8 [:handled_data]
	data8 0xff // Trigger invalid instruction interrupt
	push8 [:handled_data]
	push8 $STINT_INVALID_INST
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	push8 $STINT_INVALID_INST
	call :restore_int_handler // int8
	pop8

	//
	// Test that an assertion failure generates STINT_ASSERT_FAILURE
	//
	// When writing 8 bits
	push8 $STINT_ASSERT_FAILURE
	call :set_int_handler
	pop8
	push64 $IO_ASSERT_ADDR // $IO_ASSERT_ADDR
	push8 0                // $IO_ASSERT_ADDR, 0_8
	storepop8              // Generates assertion failure before pop
	pop8
	pop64
	// Check that :handled_data is equal to $STINT_ASSERT_FAILURE
	push8 [:handled_data]
	push8 $STINT_ASSERT_FAILURE
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// When writing 16 bits
	push8 0
	pop8 [:handled_data]
	push64 $IO_ASSERT_ADDR // $IO_ASSERT_ADDR
	push16 0               // $IO_ASSERT_ADDR, 0_16
	storepop16             // Generates assertion failure before pop
	pop16
	pop64
	// Check that :handled_data is equal to $STINT_ASSERT_FAILURE
	push8 [:handled_data]
	push8 $STINT_ASSERT_FAILURE
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// When writing 32 bits
	push8 0
	pop8 [:handled_data]
	push64 $IO_ASSERT_ADDR // $IO_ASSERT_ADDR
	push32 0               // $IO_ASSERT_ADDR, 0_32
	storepop32             // Generates assertion failure before pop
	pop32
	pop64
	// Check that :handled_data is equal to $STINT_ASSERT_FAILURE
	push8 [:handled_data]
	push8 $STINT_ASSERT_FAILURE
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// When writing 64 bits
	push8 0
	pop8 [:handled_data]
	push64 $IO_ASSERT_ADDR // $IO_ASSERT_ADDR
	push64 0               // $IO_ASSERT_ADDR, 0_64
	storepop64             // Generates assertion failure before pop
	pop64
	pop64
	// Check that :handled_data is equal to $STINT_ASSERT_FAILURE
	push8 [:handled_data]
	push8 $STINT_ASSERT_FAILURE
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// Restore original interrupt handler
	push8 $STINT_ASSERT_FAILURE
	call :restore_int_handler
	pop8
	// The fact that an assertion failure is not generated when a non-zero value is asserted
	// is amply demonstrated by the other tests.

	//
	// Test that division by zero produces STINT_DIV_BY_ZERO
	//
	// For divu8
	push8 $STINT_DIV_BY_ZERO
	call :set_int_handler
	pop8
	push8 [$IO_URAND_ADDR] // a8
	push8 0                // a8, 0_8
	divu8                  // Generates STINT_DIV_BY_ZERO before pop takes place
	pop8
	pop8
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For divu16
	push8 0
	pop8 [:handled_data]
	push16 [$IO_URAND_ADDR] // a16
	push16 0                // a16, 0_16
	divu16                  // Generates STINT_DIV_BY_ZERO before pop takes place
	pop16
	pop16
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For divu32
	push8 0
	pop8 [:handled_data]
	push32 [$IO_URAND_ADDR] // a32
	push32 0                // a32, 0_32
	divu32                  // Generates STINT_DIV_BY_ZERO before pop takes place
	pop32
	pop32
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For divu64
	push8 0
	pop8 [:handled_data]
	push64 [$IO_URAND_ADDR] // a64
	push64 0                // a64, 0_64
	divu64                  // Generates STINT_DIV_BY_ZERO before pop takes place
	pop64
	pop64
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]

	// For divru8
	push8 0
	pop8 [:handled_data]
	push8 0                // 0_8
	push8 [$IO_URAND_ADDR] // 0_8, a8
	divru8                 // Generates STINT_DIV_BY_ZERO before pop takes place
	pop8
	pop8
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For divru16
	push8 0
	pop8 [:handled_data]
	push16 0                // 0_16
	push16 [$IO_URAND_ADDR] // 0_16, a16
	divru16                 // Generates STINT_DIV_BY_ZERO before pop takes place
	pop16
	pop16
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For divru32
	push8 0
	pop8 [:handled_data]
	push32 0                // 0_32
	push32 [$IO_URAND_ADDR] // 0_32, a32
	divru32                 // Generates STINT_DIV_BY_ZERO before pop takes place
	pop32
	pop32
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For divru64
	push8 0
	pop8 [:handled_data]
	push64 0                // 0_64
	push64 [$IO_URAND_ADDR] // 0_64, a64
	divru64                 // Generates STINT_DIV_BY_ZERO before pop takes place
	pop64
	pop64
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]

	// For divi8
	push8 $STINT_DIV_BY_ZERO
	call :set_int_handler
	pop8
	push8 [$IO_URAND_ADDR] // a8
	push8 0                // a8, 0_8
	divi8                  // Generates STINT_DIV_BY_ZERO before pop takes place
	pop8
	pop8
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For divi16
	push8 0
	pop8 [:handled_data]
	push16 [$IO_URAND_ADDR] // a16
	push16 0                // a16, 0_16
	divi16                  // Generates STINT_DIV_BY_ZERO before pop takes place
	pop16
	pop16
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For divi32
	push8 0
	pop8 [:handled_data]
	push32 [$IO_URAND_ADDR] // a32
	push32 0                // a32, 0_32
	divi32                  // Generates STINT_DIV_BY_ZERO before pop takes place
	pop32
	pop32
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For divi64
	push8 0
	pop8 [:handled_data]
	push64 [$IO_URAND_ADDR] // a64
	push64 0                // a64, 0_64
	divi64                  // Generates STINT_DIV_BY_ZERO before pop takes place
	pop64
	pop64
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]

	// For divri8
	push8 0
	pop8 [:handled_data]
	push8 0                // 0_8
	push8 [$IO_URAND_ADDR] // 0_8, a8
	divri8                 // Generates STINT_DIV_BY_ZERO before pop takes place
	pop8
	pop8
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For divri16
	push8 0
	pop8 [:handled_data]
	push16 0                // 0_16
	push16 [$IO_URAND_ADDR] // 0_16, a16
	divri16                 // Generates STINT_DIV_BY_ZERO before pop takes place
	pop16
	pop16
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For divri32
	push8 0
	pop8 [:handled_data]
	push32 0                // 0_32
	push32 [$IO_URAND_ADDR] // 0_32, a32
	divri32                 // Generates STINT_DIV_BY_ZERO before pop takes place
	pop32
	pop32
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For divri64
	push8 0
	pop8 [:handled_data]
	push64 0                // 0_64
	push64 [$IO_URAND_ADDR] // 0_64, a64
	divri64                 // Generates STINT_DIV_BY_ZERO before pop takes place
	pop64
	pop64
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]

	//
	// Test that modulo by zero produces STINT_DIV_BY_ZERO
	//
	// For modu8
	push8 $STINT_DIV_BY_ZERO
	call :set_int_handler
	pop8
	push8 [$IO_URAND_ADDR] // a8
	push8 0                // a8, 0_8
	modu8                  // Generates STINT_DIV_BY_ZERO before pop takes place
	pop8
	pop8
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For modu16
	push8 0
	pop8 [:handled_data]
	push16 [$IO_URAND_ADDR] // a16
	push16 0                // a16, 0_16
	modu16                  // Generates STINT_DIV_BY_ZERO before pop takes place
	pop16
	pop16
	push8 [:handled_data]
	push8 $STINT_DIV_BY_ZERO
	ceq8
	pop8 [$IO_ASSERT_ADDR]
	// For modu32
	push8 0
	pop8 [:handled_data]
	push32 [$IO_URAND_ADDR] // a32
	push32 0                // a32, 0_32
	modu32                  // Generates STINT_DIV_BY_ZERO before pop takes place
	pop32
	pop32
	push8 [:handled_data]
